# Multi-stage build for dcm4che-ris REST API

# Stage 1: Build
FROM maven:3.9-eclipse-temurin-17-alpine AS build

WORKDIR /build

# Copy parent POM
COPY pom.xml .

# Copy all module POMs
COPY dcm4che-ris-api/pom.xml dcm4che-ris-api/
COPY dcm4che-ris-persistence/pom.xml dcm4che-ris-persistence/
COPY dcm4che-ris-core/pom.xml dcm4che-ris-core/
COPY dcm4che-ris-dicom/pom.xml dcm4che-ris-dicom/
COPY dcm4che-ris-hl7/pom.xml dcm4che-ris-hl7/
COPY dcm4che-ris-rest/pom.xml dcm4che-ris-rest/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B

# Copy source code
COPY dcm4che-ris-api/src dcm4che-ris-api/src
COPY dcm4che-ris-persistence/src dcm4che-ris-persistence/src
COPY dcm4che-ris-core/src dcm4che-ris-core/src
COPY dcm4che-ris-dicom/src dcm4che-ris-dicom/src
COPY dcm4che-ris-hl7/src dcm4che-ris-hl7/src
COPY dcm4che-ris-rest/src dcm4che-ris-rest/src

# Build the application
RUN mvn clean package -DskipTests -pl dcm4che-ris-rest -am

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="dcm4che-ris"
LABEL description="dcm4che RIS - Radiology Information System"
LABEL version="1.0.0-SNAPSHOT"

# Install curl for healthcheck
RUN apk add --no-cache curl

# Create app user
RUN addgroup -g 1000 risapp && \
    adduser -D -u 1000 -G risapp risapp

# Set working directory
WORKDIR /app

# Copy JAR from build stage
COPY --from=build /build/dcm4che-ris-rest/target/dcm4che-ris-rest-*.jar app.jar

# Create logs directory
RUN mkdir -p /app/logs && chown -R risapp:risapp /app

# Switch to non-root user
USER risapp

# Expose ports
EXPOSE 8080  # REST API
EXPOSE 11112 # DICOM MWL/MPPS
EXPOSE 2575  # HL7

# JVM options
ENV JAVA_OPTS="-Xms512m -Xmx2048m \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:+UseStringDeduplication \
    -Djava.security.egd=file:/dev/./urandom \
    -Dfile.encoding=UTF-8"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/api/ris/actuator/health || exit 1

# Run the application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
